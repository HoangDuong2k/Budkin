{
  "name": "budkin",
  "productName": "Budkin",
  "version": "0.1.0",
  "description": "Quản lý công việc trên bàn làm việc 3D: robot Budkin nhìn theo con trỏ và nhắc việc đến hạn, đèn bàn bật/tắt theme",
  "main": "./out/main/index.js",
  "author": "Hoang Duong",
  "homepage": "https://github.com/HoangDuong2k/Budkin",
  "license": "MIT",
  "private": true,
  "desktopName": "budkin.desktop",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:linux": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e-smoke.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "stats:scene": "tsx scripts/scene-stats.ts",
    "perf:idle": "tsx scripts/perf-idle.ts",
    "icons": "electron scripts/icons.cjs --no-sandbox",
    "install-check": "tsx scripts/install-check.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "maath": "^0.10.8",
    "momi-ui": "github:HoangDuong2k/momi-ui#v0.3.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "github:HoangDuong2k/momi-ui#2d4f40cbecb5476ba217657cd274aca3052ed547": true
  }
}
